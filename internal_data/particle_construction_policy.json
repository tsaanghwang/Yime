{
  "schema_version": 1,
  "policy_id": "mandarin-particle-construction-system-v1",
  "purpose": "Treat productive particle-bearing forms as typed construction evidence before any invalid-material decision.",
  "theoretical_model": {
    "principle": "助词不是依靠独立词汇意义进入核心，而是依靠稳定的语法功能、组合接口和构式生产力进入核心部件层。",
    "classification_axis": "语言类别说明部件建立什么关系；运行角色说明它是否直接显示、仅供组合或现场生成。两条轴不得混同。",
    "admission_evidence": [
      "字形与来源读音同时匹配助词用法",
      "构式具有明确的左侧或右侧选择要求",
      "部件能恢复来源已有的更大单位",
      "固定词汇和专名裁决优先于构式推断",
      "频率只衡量缓存收益，不判定材料是否无效"
    ]
  },
  "systems": {
    "structural_particles": {
      "description": "建立修饰、状语或补语关系的结构助词。",
      "constructions": {
        "attributive_de": {
          "marker": "的",
          "numeric_pinyin": ["de5"],
          "marker_position": "noninitial",
          "attachment": "modifier + 的 + optional_head",
          "left_requirement": "modifier_or_comparand",
          "right_requirement": "optional_nominal_head",
          "interface": "nominal_or_attributive_right_edge"
        },
        "adverbial_de": {
          "marker": "地",
          "numeric_pinyin": ["de5"],
          "marker_position": "noninitial",
          "attachment": "adverbial + 地 + predicate",
          "left_requirement": "adverbial_modifier",
          "right_requirement": "predicate",
          "interface": "requires_right_predicate"
        },
        "complement_de": {
          "marker": "得",
          "numeric_pinyin": ["de5"],
          "marker_position": "noninitial",
          "attachment": "predicate + 得 + complement",
          "left_requirement": "predicate",
          "right_requirement": "complement",
          "interface": "requires_right_complement"
        }
      }
    },
    "aspectual_particles": {
      "description": "附着于谓词并标记持续、完成或经历体貌的动态助词。",
      "constructions": {
        "durative_zhe": {
          "marker": "着",
          "numeric_pinyin": ["zhe5"],
          "marker_position": "noninitial",
          "attachment": "predicate + 着",
          "left_requirement": "predicate",
          "right_requirement": "optional_argument_or_continuation",
          "interface": "aspectual_predicate"
        },
        "perfective_le": {
          "marker": "了",
          "numeric_pinyin": ["le5"],
          "marker_position": "noninitial",
          "attachment": "predicate + 了",
          "left_requirement": "predicate",
          "right_requirement": "optional_argument_or_continuation",
          "interface": "aspectual_predicate"
        },
        "experiential_guo": {
          "marker": "过",
          "numeric_pinyin": ["guo4"],
          "marker_position": "noninitial",
          "attachment": "predicate + 过",
          "left_requirement": "predicate",
          "right_requirement": "optional_argument_or_continuation",
          "interface": "aspectual_predicate"
        }
      }
    },
    "modal_particles": {
