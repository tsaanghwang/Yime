  "runtime_roles": {
    "display_and_component": "固定表达可直接显示，也可被更大组合复用。",
    "component_only_candidate": "有稳定构式接口，但直接显示价值尚未成立。",
    "runtime_generated": "由更小部件现场组成，不预占核心缓存。",
    "dynamic_sentence_candidate": "较长的小句或句子只作动态恢复证据。"
  },
  "safeguards": {
    "source_readings_only": true,
    "lexical_decisions_override_construction_inference": true,
