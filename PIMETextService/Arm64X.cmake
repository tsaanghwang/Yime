# Only the in-process TSF DLL is dual ABI. Launcher and backend are native ARM64.
# https://learn.microsoft.com/windows/arm/arm64x-build
if(NOT MSVC OR MSVC_VERSION LESS 1941)
    message(FATAL_ERROR "PIME ARM64X requires MSVC 19.41 or later")
endif()
if(PIME_ARM64X_STAGE STREQUAL "ARM64")
    if(NOT CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
        message(FATAL_ERROR "The native ARM64X stage requires -A ARM64")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/arm64x")
    target_link_options(PIMETextService PRIVATE
        "/LINKREPROFULLPATHRSP:${CMAKE_CURRENT_BINARY_DIR}/arm64x/PIMETextService.rsp")
elseif(PIME_ARM64X_STAGE STREQUAL "ARM64EC")
    if(NOT CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64EC")
        message(FATAL_ERROR "The hybrid ARM64X stage requires -A ARM64EC")
    endif()
    set(PIME_ARM64X_NATIVE_LINK_RSP "" CACHE FILEPATH "Native Release linker response")
    if(NOT IS_ABSOLUTE "${PIME_ARM64X_NATIVE_LINK_RSP}" OR NOT EXISTS "${PIME_ARM64X_NATIVE_LINK_RSP}")
        message(FATAL_ERROR "Provide the completed native linker response")
    endif()
    file(STRINGS "${PIME_ARM64X_NATIVE_LINK_RSP}" _lines)
    set(_objects)
    set(_libraries)
    set(_definition)
    foreach(_line IN LISTS _lines)
        string(STRIP "${_line}" _line)
        string(REGEX REPLACE "^\"|\"$" "" _line "${_line}")
        if(_line MATCHES "^/[Dd][Ee][Ff]:(.*)$")
            string(REGEX REPLACE "^\"|\"$" "" _item "${CMAKE_MATCH_1}")
            list(APPEND _definition "${_item}")
        else()
            string(TOLOWER "${_line}" _lower)
            if(_lower MATCHES "[.]obj$")
                list(APPEND _objects "${_line}")
            elseif(_lower MATCHES "[.]lib$")
                list(APPEND _libraries "${_line}")
            endif()
        endif()
    endforeach()
    list(LENGTH _definition _count)
    if(NOT _objects OR NOT _libraries OR NOT _count EQUAL 1)
        message(FATAL_ERROR "Incomplete native linker response")
    endif()
    foreach(_item IN LISTS _objects _libraries _definition)
        if(NOT IS_ABSOLUTE "${_item}" OR NOT EXISTS "${_item}")
            message(FATAL_ERROR "Native link input is not an existing absolute file: ${_item}")
        endif()
    endforeach()
    set_source_files_properties(${_objects} PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
    target_sources(PIMETextService PRIVATE ${_objects})
    # Lowercase /machine stays in AdditionalOptions after VS's ARM64EC switch.
    target_link_options(PIMETextService PRIVATE /machine:arm64x "/defArm64Native:${_definition}")
    target_link_libraries(PIMETextService PRIVATE ${_libraries})
else()
    message(FATAL_ERROR "Unknown PIME_ARM64X_STAGE")
endif()
