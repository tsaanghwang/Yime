{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DP1-U supplied isolated authorization and preflight contract (no execution capability)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization",
    "preflight",
    "product_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "yime-rime-pime-dp1u-isolated-preflight-evidence-v1"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "approval_reference",
        "approved_by",
        "approved_at_utc",
        "expires_at_utc",
        "run_id",
        "target_name",
        "target_machine_id",
        "initiating_sid",
        "state_root",
        "install_root",
        "recovery_root",
        "package_sha256",
        "canonical_receipt_sha256",
        "product_boundary_sha256",
        "affected_product",
        "target_class",
        "package_architectures",
        "operations",
        "production_rime_pime_allowed",
        "yimecore_local12_allowed",
        "default_input_method_mutation_allowed",
        "production_user_data_allowed",
        "cross_product_mutation_allowed",
        "historical_payload_execution_allowed",
        "shared_runtime_or_state_allowed"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "yime-rime-pime-dp1u-isolated-authorization-v1"
        },
        "approval_reference": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "expires_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "target_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9-]{0,62}|\u8ba1\u7b97\u673a)$"
        },
        "target_machine_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "initiating_sid": {
          "type": "string",
          "minLength": 1,
          "pattern": "^S-1-5-21-[1-9][0-9]*-[1-9][0-9]*-[1-9][0-9]*-[1-9][0-9]*$"
        },
        "state_root": {
          "type": "string",
          "minLength": 1
