          "type": "boolean",
          "const": false
        },
        "yimecore_local12_allowed": {
          "type": "boolean",
          "const": false
        },
        "default_input_method_mutation_allowed": {
          "type": "boolean",
          "const": false
        },
        "production_user_data_allowed": {
          "type": "boolean",
          "const": false
