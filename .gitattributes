*.md text eol=lf
*.go text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# This generated sidecar is hashed byte-for-byte in
# yime_core_source_manifest.json. Keep CI and Windows worktrees identical.
go-backend/input_methods/yime/data/yime_pinyin_reverse_source.tsv text eol=lf
go-backend/input_methods/yime/data/yime_erhua_reverse_source.tsv text eol=lf

# Preserve the imported libIME2 base snapshot byte-for-byte. Its historical
# whitespace is upstream provenance, while new component changes remain
# reviewable through the libIME2 commit boundary gate.
libIME2/** -text -whitespace

# Cargo verifies vendored crate files byte-for-byte against each package's
# .cargo-checksum.json. Corrosion is also guarded by a complete tree digest.
# Never let platform checkout settings rewrite either upstream snapshot.
PIMELauncher/vendor/** -text -whitespace
third_party/corrosion/** -text -whitespace
third_party/go-winres/** -text -whitespace

# L6 references these historical raw JSON files and their reviewed index by
# SHA-256. Preserve original bytes when moving between Windows checkouts.
docs/testing/l6/local12-evidence-20260908/*.json -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/testing/l6/2026-09-08-local12-readiness-v2-*.json -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/yimecore/local12-readiness-evidence.json -text !eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# DP1-U native observations record these reviewed source bytes as LF hashes.
tools/dual-product/rime-pime-dp1u-native-facts.cs text eol=lf
tools/dual-product/rime-pime-dp1u-native-probe.psm1 text eol=lf
tools/dual-product/test-rime-pime-dp1u-native-probe.ps1 text eol=lf
tools/dual-product/test-rime-pime-dp1u-native-candidate.ps1 text eol=lf

# The prepared local.12 fault package records these source hashes as well.
tools/yimecore/local12-maintenance-preparation.psm1 text eol=lf
tools/yimecore/prepare-local12-maintenance.ps1 text eol=lf
tools/yimecore/test-local12-maintenance-preparation.ps1 text eol=lf
