{
  "schema_version": 1,
  "model_id": "yime-contextual-tone-quality-hypothesis-v1",
  "revision": 3,
  "status": "research_only",
  "claim": "可证伪、可替换的调层—质层工程假设；不主张已经概括普通话全部语流事实",
  "evaluation_strategy": "bounded_non_recursive_partial_order",
  "runtime_enabled": false,
  "maximum_global_passes": 1,
  "layers": [
    {"layer_id": "P0", "order": 0, "name": "韵律域与构式分支", "output": "prosodic_domain,reading_branch"},
    {"layer_id": "T1", "order": 1, "name": "非轻声条件调值", "output": "provisional_surface_tone"},
    {"layer_id": "T2", "order": 2, "name": "轻声身份与表层调值", "output": "neutral_identity,neutral_surface_tone"},
    {"layer_id": "Q3", "order": 3, "name": "质层（音质层）音变与结构分支", "output": "surface_quality,surface_initial,particle_realization,boundary_quality,quality_temporal_association,erhua_path"},
    {"layer_id": "C4", "order": 4, "name": "四音元与三模式投影", "output": "surface_yinyuan_ids,three_mode_codes"}
  ],
  "rules": [
    {
      "rule_id": "prosodic_domain_partition_v1",
      "name": "显式韵律域划分",
      "phenomenon": "prosody",
      "layer_id": "P0",
      "activation": "research_only",
      "scope": "只接受词条、构式、停顿或人工分组证据；不得运行时猜测",
      "reads": ["canonical_text", "lexical_boundary", "construction_tag", "pause_evidence"],
      "writes": ["prosodic_domain"],
      "requires_prosodic_domain": false,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "mixed_research_and_adjudication",
      "note": "三上声及更长序列没有明确分组时不得交给生产性规则"
    },
    {
      "rule_id": "construction_reading_branch_v1",
      "name": "构式读法分支",
      "phenomenon": "construction",
      "layer_id": "P0",
      "activation": "research_only",
      "scope": "V一V、A不A、V不V、重叠式、数字串、序数和固定短语",
      "reads": ["canonical_text", "construction_tag", "prosodic_domain"],
      "writes": ["reading_branch"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "construction_record",
      "note": "先选择读法分支，不把构式差异伪装成全局规则优先级"
    },
    {
      "rule_id": "t3_context_assignment_v1",
      "name": "上声语境调值配置",
      "phenomenon": "third_tone",
      "layer_id": "T1",
      "activation": "research_only",
      "scope": "双上声且韵律域明确；三上声及更长序列须显式分组",
      "reads": ["canonical_tone_class", "prosodic_domain", "reading_branch"],
      "writes": ["provisional_surface_tone"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "rule_plus_explicit_grouping",
      "note": "整域一次赋值；规则输出不得重新触发本规则"
    },
    {
      "rule_id": "yi_context_assignment_v1",
      "name": "一的特殊条件调值",
      "phenomenon": "tone1_special",
      "layer_id": "T1",
      "activation": "research_only",
      "scope": "排除单用、序数、数字串和构式轻声后的明确词语记录",
      "reads": ["canonical_following_tone", "reading_branch", "prosodic_domain"],
      "writes": ["provisional_surface_tone"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "reviewed_word_or_phrase",
      "note": "条件读取后续音节规范调类，不读取上声规则输出"
    },
    {
      "rule_id": "qi_ba_optional_assignment_v1",
      "name": "七八可选特殊条件调值",
      "phenomenon": "tone1_optional",
      "layer_id": "T1",
      "activation": "deferred",
      "scope": "只允许有来源的固定词或短语，不建立阴平全局规则",
      "reads": ["canonical_following_tone", "source_variant"],
      "writes": ["provisional_surface_tone"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "variant_specific",
      "note": "默认不启用"
    },
    {
      "rule_id": "bu_context_assignment_v1",
      "name": "不的特殊条件调值",
      "phenomenon": "tone4_special",
      "layer_id": "T1",
      "activation": "research_only",
      "scope": "排除构式轻声后的明确词语记录",
      "reads": ["canonical_following_tone", "reading_branch", "prosodic_domain"],
      "writes": ["provisional_surface_tone"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "reviewed_word_or_phrase",
      "note": "当前三调级模型中不推广到其它去声字"
    },
    {
      "rule_id": "lexical_neutral_identity_v1",
      "name": "词汇轻声身份",
      "phenomenon": "lexical_neutral_tone",
      "layer_id": "T2",
      "activation": "research_only",
      "scope": "有来源的具体词条轻声；不从无调拼音全局推断",
      "reads": ["reading_branch", "source_observation"],
      "writes": ["neutral_identity"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "attested_lexical_reading",
      "note": "保留数字调5兼容路径"
    },
    {
      "rule_id": "constructional_neutral_identity_v1",
      "name": "构式轻声身份",
      "phenomenon": "constructional_neutral_tone",
      "layer_id": "T2",
      "activation": "research_only",
      "scope": "V一V、A不A、V不V及经审定的重叠式",
      "reads": ["reading_branch", "construction_tag"],
      "writes": ["neutral_identity"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "construction_record",
      "note": "命中本分支后阻断同一音节的一或不条件调值"
    },
    {
      "rule_id": "neutral_surface_pitch_v1",
      "name": "轻声表层调值",
      "phenomenon": "neutral_surface_pitch",
      "layer_id": "T2",
      "activation": "research_only",
      "scope": "有非轻声词内前驱的单个轻声音节",
      "reads": ["neutral_identity", "previous_provisional_surface_tone", "prosodic_domain"],
      "writes": ["neutral_surface_tone"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "provisional_surface_model",
      "note": "连续轻声和无词内前驱继续暂缓"
    },
    {
      "rule_id": "consecutive_neutral_chain_v1",
      "name": "连续轻声链",
      "phenomenon": "neutral_chain",
      "layer_id": "T2",
      "activation": "deferred",
      "scope": "前驱本身为轻声的记录",
      "reads": ["neutral_identity", "prosodic_domain", "source_observation"],
      "writes": ["neutral_surface_tone"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "unresolved",
      "note": "不得把前一轻声机械还原为规范调号"
    },
    {
      "rule_id": "er_suffix_branch_v1",
      "name": "儿尾结构分支",
      "phenomenon": "er_suffix",
      "layer_id": "P0",
      "activation": "research_only",
      "scope": "独立ér、轻声儿缀、融合儿化和口语儿化提示",
      "reads": ["source_observation", "orthographic_er", "attachment_index"],
      "writes": ["erhua_path"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "structured_source_record",
      "note": "各路径并行保存，不从扁平er5码删除音节"
    },
    {
      "rule_id": "er_suffix_neutral_pitch_v1",
      "name": "轻声儿缀表层调值",
      "phenomenon": "er_suffix_neutral",
      "layer_id": "T2",
      "activation": "research_only",
      "scope": "已选择轻声儿缀分支的记录",
      "reads": ["erhua_path", "previous_provisional_surface_tone"],
      "writes": ["neutral_surface_tone"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "compatibility_model",
      "note": "它是儿缀兼容路径，不宣称等同融合儿化"
    },
    {
      "rule_id": "fused_erhua_quality_v1",
      "name": "融合儿化音质实现",
      "phenomenon": "fused_erhua",
      "layer_id": "Q3",
      "activation": "deferred",
      "scope": "已有儿化韵类别和附着位置的记录",
      "reads": ["erhua_path", "canonical_yinyuan_ids", "erhua_class"],
      "writes": ["surface_quality"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "unresolved_representation",
      "note": "儿化韵表和音元目标未审定前不执行"
    },
    {
      "rule_id": "zero_initial_realization_v1",
      "name": "虚首音实际音值",
      "phenomenon": "zero_initial_realization",
      "layer_id": "Q3",
      "activation": "deferred",
      "scope": "有来源记录的零声母音节及其具体语境读法",
      "reads": ["canonical_yinyuan_ids", "syllable_onset_environment", "source_observation", "prosodic_domain"],
      "writes": ["surface_initial", "surface_quality"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "unresolved_representation",
      "note": "只记录虚首音的表层实现；不得回写规范零声母分析或基础首音码"
    },
    {
      "rule_id": "particle_a_allomorphy_v1",
      "name": "语气词啊的音变",
      "phenomenon": "particle_a_allomorphy",
      "layer_id": "Q3",
      "activation": "deferred",
      "scope": "有显式语气词记录且前一音节末音类别已确定的词或构式",
      "reads": ["previous_surface_final", "particle_identity", "canonical_yinyuan_ids", "prosodic_domain"],
      "writes": ["particle_realization", "surface_initial", "surface_quality"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "rule_plus_explicit_construction",
      "note": "不得仅据前音自动替换候选汉字；ŋ、z、卷舌类首音 ID 未审定前不投影"
    },
    {
      "rule_id": "boundary_quality_interaction_v1",
      "name": "音节边界同化或异化",
      "phenomenon": "boundary_assimilation_dissimilation",
      "layer_id": "Q3",
      "activation": "deferred",
      "scope": "前一音节末音与后一音节首音之间有来源和明确边界的同化或异化记录",
      "reads": ["previous_surface_final", "next_surface_initial", "lexical_boundary", "prosodic_domain", "source_observation"],
      "writes": ["boundary_quality", "surface_quality"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "phenomenon_specific_record",
      "note": "不得从相邻音元相似性自动类推出全局规则"
    },
    {
      "rule_id": "quality_weakening_extension_v1",
      "name": "音质弱化与时域延展",
      "phenomenon": "quality_weakening_extension",
      "layer_id": "Q3",
      "activation": "deferred",
      "scope": "有来源的音质弱化，以及相邻韵核音质在时域中的延展或联结",
      "reads": ["canonical_yinyuan_ids", "adjacent_nucleus_quality", "parallel_pitch_features", "source_observation", "prosodic_domain"],
      "writes": ["surface_quality", "quality_temporal_association"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "unresolved_quality_substitution",
      "note": "音元模型只允许音质替换；相邻韵核音质可以延展并联结到相应时域，同时由该时域负载（承载）并行的音高特征"
    },
    {
      "rule_id": "other_quality_change_v1",
      "name": "其它质层音变",
      "phenomenon": "other_quality_change",
      "layer_id": "Q3",
      "activation": "deferred",
      "scope": "不能归入既有五类且有独立来源、适用范围和排除项的音质变化",
      "reads": ["canonical_yinyuan_ids", "source_observation", "prosodic_domain"],
      "writes": ["surface_quality"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "unclassified_research_record",
      "note": "兜底分类不是兜底生成规则；每一种现象必须另立规则 ID 后才能试算"
    },
    {
      "rule_id": "three_mode_projection_v1",
      "name": "统一三模式投影",
      "phenomenon": "code_projection",
      "layer_id": "C4",
      "activation": "research_only",
      "scope": "已经完成全部语境裁决的结构化记录",
      "reads": ["provisional_surface_tone", "neutral_surface_tone", "surface_quality", "surface_initial", "particle_realization", "boundary_quality", "quality_temporal_association", "canonical_yinyuan_ids"],
      "writes": ["surface_yinyuan_ids", "full_code", "variable_code", "shorthand_code"],
      "requires_prosodic_domain": true,
      "maximum_applications_per_syllable": 1,
      "recursive": false,
      "evidence_class": "deterministic_engineering_projection",
      "note": "只离线投影；运行时输出仍为零"
    }
  ],
  "dependencies": [
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "construction_reading_branch_v1", "relation": "precedes", "condition": "all records"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "t3_context_assignment_v1", "relation": "requires", "condition": "third-tone domain"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "qi_ba_optional_assignment_v1", "relation": "requires", "condition": "七八可选变调记录"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "er_suffix_branch_v1", "relation": "requires", "condition": "儿尾或儿化来源记录"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "zero_initial_realization_v1", "relation": "requires", "condition": "虚首音表层实现记录"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "particle_a_allomorphy_v1", "relation": "requires", "condition": "语气词啊构式记录"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "boundary_quality_interaction_v1", "relation": "requires", "condition": "跨音节边界音质变化记录"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "quality_weakening_extension_v1", "relation": "requires", "condition": "音质弱化或时域延展记录"},
    {"from_rule": "prosodic_domain_partition_v1", "to_rule": "other_quality_change_v1", "relation": "requires", "condition": "其它音质变化研究记录"},
    {"from_rule": "construction_reading_branch_v1", "to_rule": "yi_context_assignment_v1", "relation": "precedes", "condition": "contains 一"},
    {"from_rule": "construction_reading_branch_v1", "to_rule": "bu_context_assignment_v1", "relation": "precedes", "condition": "contains 不"},
    {"from_rule": "construction_reading_branch_v1", "to_rule": "lexical_neutral_identity_v1", "relation": "precedes", "condition": "lexical neutral branch"},
    {"from_rule": "construction_reading_branch_v1", "to_rule": "constructional_neutral_identity_v1", "relation": "precedes", "condition": "constructional neutral branch"},
    {"from_rule": "er_suffix_branch_v1", "to_rule": "er_suffix_neutral_pitch_v1", "relation": "precedes", "condition": "suffix branch"},
    {"from_rule": "er_suffix_branch_v1", "to_rule": "fused_erhua_quality_v1", "relation": "precedes", "condition": "fused branch"},
    {"from_rule": "t3_context_assignment_v1", "to_rule": "neutral_surface_pitch_v1", "relation": "precedes", "condition": "preceding syllable is tone 3"},
    {"from_rule": "yi_context_assignment_v1", "to_rule": "neutral_surface_pitch_v1", "relation": "precedes", "condition": "preceding syllable is 一"},
    {"from_rule": "bu_context_assignment_v1", "to_rule": "neutral_surface_pitch_v1", "relation": "precedes", "condition": "preceding syllable is 不"},
    {"from_rule": "lexical_neutral_identity_v1", "to_rule": "neutral_surface_pitch_v1", "relation": "requires", "condition": "lexical neutral"},
    {"from_rule": "constructional_neutral_identity_v1", "to_rule": "neutral_surface_pitch_v1", "relation": "requires", "condition": "constructional neutral"},
    {"from_rule": "neutral_surface_pitch_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "surface neutral branch"},
    {"from_rule": "er_suffix_neutral_pitch_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "suffix compatibility branch"},
    {"from_rule": "fused_erhua_quality_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "fused branch"},
    {"from_rule": "zero_initial_realization_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "zero-initial realization branch"},
    {"from_rule": "particle_a_allomorphy_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "particle allomorphy branch"},
    {"from_rule": "boundary_quality_interaction_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "boundary quality branch"},
    {"from_rule": "quality_weakening_extension_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "quality weakening or extension branch"},
    {"from_rule": "other_quality_change_v1", "to_rule": "three_mode_projection_v1", "relation": "precedes", "condition": "other quality branch"}
  ]
}
