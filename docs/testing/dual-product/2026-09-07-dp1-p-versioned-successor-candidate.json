    {
      "kind": "version-grammar-and-resource-propagation-baseline",
      "outcome": "fixed-before-versioned-candidate",
      "detail": "The source baseline accepted leading-zero core components and did not lock both Launcher numeric VERSIONINFO calls or the TextService numeric PRODUCTVERSION line. The grammar and propagation anchors now fail closed."
    },
    {
      "kind": "ci-installer-leaf-ambiguity",
      "outcome": "fixed-before-versioned-candidate",
