  "development_gate_regressions": [
    {
      "kind": "pre-intent-classification",
      "outcome": "fixed-before-final-suite",
      "detail": "An intent data file without its sealed sidecar was initially treated as durable post-intent state. Post-intent recovery now requires both leaves; data-only state revalidates the source."
    },
    {
      "kind": "interrupted-copy-orphan-membership",
      "outcome": "fixed-before-final-suite",
      "detail": "An interrupted .writing file could remain in the staged capsule. Orphans are now moved with no-replace semantics into a case-local quarantine outside the capsule before exact-set validation and final ownership."
    },
    {
      "kind": "content-addressed-object-binding",
      "outcome": "fixed-before-final-suite",
      "detail": "The reader initially checked a manifest object's byte count but did not explicitly require its actual SHA-256 to equal the manifest row and object filename. A same-length replacement with a rewritten object sidecar is now rejected in both final and intent-stage readers."
    },
    {
      "kind": "semantic-manifest-binding",
      "outcome": "fixed-before-final-suite",
      "detail": "A fully self-consistent reseal could remove or alter the runner, retained-receipt or candidate-installer semantic row mapping. The reader now requires unique path, digest and byte bindings and rereads the runner and receipt semantics."
    },
    {
      "kind": "scalar-and-path-shape",
      "outcome": "fixed-before-final-suite",
      "detail": "Single-element arrays, zero build-manifest bytes, non-false core.autocrlf and non-canonical manifest member paths were not all rejected. Exact scalar types, positive lengths and full Windows path-segment rules are now enforced."
    },
    {
      "kind": "pure-review-property-access",
      "outcome": "fixed-before-final-suite",
      "detail": "The first pure-review implementation could evaluate ScriptProperty getters and could admit null or non-string identity bindings. Only NoteProperty values are now read, with strict nonempty scalar types."
    },
    {
      "kind": "pure-review-path-and-repository-binding",
      "outcome": "fixed-before-final-suite",
      "detail": "Dot segments, invalid Windows characters, a relative adapter path and incompletely cross-bound repository roots could leave review sections ready. Paths are now canonical, the adapter path is exact, and repository identities are cross-bound."
    },
    {
      "kind": "pure-review-readiness-dependency",
      "outcome": "fixed-before-final-suite",
      "detail": "An invalid upstream source identity made the overall review fail but could leave downstream archive, adapter and authorization readiness true. Downstream readiness now depends on the complete valid upstream chain."
    },
    {
      "kind": "ps5-ads-negative-fixture",
      "outcome": "test-fixture-fixed-before-final-suite",
      "detail": "The first ADS negative fixture used a .NET path suffix that Windows PowerShell 5.1 rejected before exercising the contract. It now uses the FileSystem provider Stream parameter in both shells."
    }
  ],
